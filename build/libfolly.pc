prefix=/usr/local
exec_prefix=/usr/local
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libfolly
Description: Facebook (Folly) C++ library
Version: 0.58.0-dev
Cflags: -I${includedir}  -Werror=unknown-warning-option -DFMT_SHARED -DBOOST_CONTEXT_NO_LIB -DBOOST_CONTEXT_DYN_LINK -DBOOST_FILESYSTEM_NO_LIB -DBOOST_FILESYSTEM_DYN_LINK -DBOOST_PROGRAM_OPTIONS_NO_LIB -DBOOST_PROGRAM_OPTIONS_DYN_LINK -DBOOST_REGEX_NO_LIB -DBOOST_REGEX_DYN_LINK -DBOOST_THREAD_NO_LIB -DBOOST_THREAD_DYN_LINK -DGFLAGS_IS_A_DLL=0 -I/opt/homebrew/include -I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include
Libs: -L${libdir} -lfolly
Libs.private: /opt/homebrew/lib/libdouble-conversion.dylib /opt/homebrew/lib/libglog.dylib /opt/homebrew/lib/libevent.dylib /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib/libz.tbd /opt/homebrew/lib/libssl.dylib /opt/homebrew/lib/libcrypto.dylib /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib/libbz2.tbd /opt/homebrew/lib/liblzma.dylib /opt/homebrew/lib/liblz4.dylib /opt/homebrew/lib/libzstd.dylib /opt/homebrew/lib/libsnappy.dylib -lc++abi
